      "com.telepathicgrunt.wits.fabric.entrypoints.Main"
    ]
  },
  "mixins": [],

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
